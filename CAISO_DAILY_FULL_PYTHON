# --- Main ---
# =========================================================

def main() -> int:
    datekey = yesterday_datekey()
    try:
        csv_path = download_csv(datekey)
    except Exception as e:
        logging.exception("Download failed")
        print(f"ERROR: {e}", file=sys.stderr)
        return 1

    try:
        df, stats = compute_stats(csv_path)
        report_date = datetime.strptime(datekey, "%Y%m%d").strftime("%m/%d/%Y")

        pdf_constant = os.path.join(ONE_DRIVE_PATH, PDF_CONSTANT_FILENAME)
        pdf_dated = os.path.join(ONE_DRIVE_PATH, PDF_DATED_TEMPLATE.format(datekey=datekey))
        png_constant = os.path.join(ONE_DRIVE_PATH, PNG_CONSTANT_FILENAME)

        build_dashboard(df, stats, report_date, pdf_constant, png_constant)
        # keep a dated archive copy of the PDF too
        import shutil
        shutil.copyfile(pdf_constant, pdf_dated)

        logging.info("Saved dashboard: %s, %s, %s", pdf_constant, pdf_dated, png_constant)
        print(f"OK: dashboard saved to {pdf_constant}")
        return 0
    except Exception as e:
        logging.exception("Dashboard build failed")
        print(f"ERROR: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
