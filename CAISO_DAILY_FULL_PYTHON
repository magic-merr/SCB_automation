# --- Stats ---
# =========================================================

def compute_stats(csv_path: str) -> pd.DataFrame:
    df = pd.read_csv(csv_path)
    df.columns = [c.strip() for c in df.columns]
    missing = [c for c in CATEGORIES if c not in df.columns]
    if missing:
        raise ValueError(f"CSV is missing expected columns: {missing}")

    start = df.iloc[0][CATEGORIES]
    end = df.iloc[-1][CATEGORIES]
    avg = df[CATEGORIES].mean()
    net_mw = end - start
    import numpy as np
    start_denom = start.abs().astype(float)
    start_denom = start_denom.where(start_denom != 0, np.nan)
    net_pct = (end - start) / start_denom

    stats = pd.DataFrame({
        "start_mw": start,
        "end_mw": end,
        "avg_mw": avg,
        "net_mw": net_mw,
        "net_pct": net_pct,
    })
    # chart-safe (floor negatives at 0, only used for pie slices)
    stats["start_chart"] = stats["start_mw"].clip(lower=0)
    stats["end_chart"] = stats["end_mw"].clip(lower=0)
    stats["avg_chart"] = stats["avg_mw"].clip(lower=0)
    return df, stats


# =========================================================
# --- Rendering ---
# =========================================================

def pie_autopct(values):
    total = sum(values)

    def fmt(pct):
        val = pct / 100.0 * total
        if pct < 2.5:  # skip clutter on tiny slices
            return ""
        return f"{val:,.0f}\n{pct:.0f}%"
    return fmt


def draw_pie(ax, values, title):
    colors = COLORS[:len(values)]
    nonzero_mask = values > 0
    wedges, _, autotexts = ax.pie(
        values, colors=colors, autopct=pie_autopct(values),
        pctdistance=0.72, startangle=90,
        textprops={"fontsize": 7},
        wedgeprops={"linewidth": 0.5, "edgecolor": "white"},
    )
    ax.set_title(title, fontsize=10, fontweight="bold")
    for t in autotexts:
        t.set_fontsize(6.5)
    # lock a consistent view window so label overflow never shrinks the pie itself
    ax.set_xlim(-1.35, 1.35)
    ax.set_ylim(-1.35, 1.35)
    ax.set_aspect("equal")


def draw_bar(ax, categories, values, title, ylabel, is_pct=False):
    colors = ["#2E6F9E" if v >= 0 else "#B0413E" for v in values]
    bars = ax.bar(categories, values, color=colors)
    ax.set_title(title, fontsize=10, fontweight="bold")
    ax.set_ylabel(ylabel, fontsize=7)
    ax.axhline(0, color="black", linewidth=0.6)
    ax.tick_params(axis="x", labelrotation=45, labelsize=6)
    ax.tick_params(axis="y", labelsize=6)
    for spine in ("top", "right"):
        ax.spines[spine].set_visible(False)
    for b, v in zip(bars, values):
        label = f"{v:.0%}" if is_pct else f"{v:,.0f}"
        offset = (abs(max(values, key=abs)) * 0.03) if len(values) else 0
        y = b.get_height() + (offset if v >= 0 else -offset)
        va = "bottom" if v >= 0 else "top"
        ax.text(b.get_x() + b.get_width() / 2, y, label, ha="center", va=va, fontsize=6)
    if is_pct:
        ax.yaxis.set_major_formatter(matplotlib.ticker.PercentFormatter(xmax=1))


def draw_line(ax, df):
    time_idx = pd.to_datetime(df["Time"], format="%H:%M")
    for cat, color in zip(CATEGORIES, COLORS):
        ax.plot(time_idx, df[cat], label=cat, color=color, linewidth=1.1)
    ax.set_title("Supply Trend Through the Day (5-min intervals)", fontsize=10, fontweight="bold")
    ax.set_ylabel("MW", fontsize=7)
    ax.xaxis.set_major_formatter(mdates.DateFormatter("%H:%M"))
    ax.xaxis.set_major_locator(mdates.HourLocator(interval=2))
    ax.tick_params(axis="x", labelrotation=0, labelsize=6)
    ax.tick_params(axis="y", labelsize=6)
    ax.axhline(0, color="black", linewidth=0.5)
    ax.legend(fontsize=6, ncol=7, loc="upper center", bbox_to_anchor=(0.5, -0.13), frameon=False,
              columnspacing=1.0, handlelength=1.4)
    for spine in ("top", "right"):
        ax.spines[spine].set_visible(False)


def build_dashboard(df: pd.DataFrame, stats: pd.DataFrame, report_date: str, out_pdf: str, out_png: str = None):
    fig = plt.figure(figsize=(8.5, 13), dpi=200)
    gs = GridSpec(4, 2, figure=fig, height_ratios=[1, 1, 1, 1.05], hspace=0.45, wspace=0.25,
                  top=0.91, bottom=0.09, left=0.07, right=0.95)

    fig.suptitle("CAISO Daily Fuel Mix Dashboard", fontsize=15, fontweight="bold", x=0.07, y=0.985, ha="left")
    fig.text(0.07, 0.955, f"Date: {report_date}   |   Source: CAISO fuelsource.csv (5-min intervals)",
              fontsize=8.5, style="italic", color="#444444")

    draw_pie(fig.add_subplot(gs[0, 0]), stats["start_chart"].values, "Fuel Mix at Start of Day (00:00)")
    draw_pie(fig.add_subplot(gs[0, 1]), stats["end_chart"].values, "Fuel Mix at End of Day (23:55)")
    draw_pie(fig.add_subplot(gs[1, 0]), stats["avg_chart"].values, "Fuel Mix — Daily Average")

    ax_legend = fig.add_subplot(gs[1, 1])
    ax_legend.axis("off")
    handles = [plt.Rectangle((0, 0), 1, 1, color=c) for c in COLORS]
    ax_legend.legend(handles, CATEGORIES, loc="center", fontsize=7.5, frameon=False, ncol=2, title="Fuel Types")

    draw_bar(fig.add_subplot(gs[2, 0]), CATEGORIES, stats["net_mw"].values,
              "Net Change, End vs Start (MW)", "MW")
    net_pct_vals = stats["net_pct"].astype(float).fillna(0.0).values
    draw_bar(fig.add_subplot(gs[2, 1]), CATEGORIES, net_pct_vals,
              "Net Change, End vs Start (% of Morning Level)", "% of 00:00 level", is_pct=True)

    ax_line = fig.add_subplot(gs[3, :])
    draw_line(ax_line, df)

    fig.text(0.07, 0.008, "Note: negative overnight MW (e.g. solar net-metering) is floored at 0 in the pie "
                            "charts only; true signed values are used everywhere else.",
              fontsize=6.5, style="italic", color="#666666")

    fig.savefig(out_pdf, format="pdf")
    if out_png:
        fig.savefig(out_png, format="png", dpi=200)
    plt.close(fig)


